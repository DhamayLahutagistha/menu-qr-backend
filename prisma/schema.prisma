// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("OWNER") @db.VarChar(10)
  // role: "ADMIN" | "OWNER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]

  @@map("users")
}

model Store {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  address     String?  @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  logoUrl     String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  // Info pembayaran (QRIS, transfer, dll) — bisa diisi/diubah oleh ADMIN
  qrisImageUrl  String?  @db.VarChar(255)
  bankName      String?  @db.VarChar(50)
  bankAccount   String?  @db.VarChar(50)
  bankHolder    String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String @db.VarChar(36)
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categories Category[]
  orders     Order[]

  @@map("stores")
}

model Category {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String @db.VarChar(36)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  price       Int
  imageUrl    String?  @db.VarChar(255)
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String   @db.VarChar(36)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@map("menu_items")
}

model Order {
  id          String   @id @default(uuid()) @db.VarChar(36)
  orderNumber String   @unique @db.VarChar(20)
  tableNumber String?  @db.VarChar(10)
  status      String   @default("PENDING") @db.VarChar(20)
  // status: "PENDING" | "PREPARING" | "READY" | "COMPLETED" | "CANCELLED"
  source      String   @default("IN_APP") @db.VarChar(10)
  // source: "IN_APP" | "MANUAL"
  notes       String?  @db.Text
  totalAmount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeId String @db.VarChar(36)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id       String  @id @default(uuid()) @db.VarChar(36)
  qty      Int
  price    Int
  subtotal Int
  note     String? @db.VarChar(255)

  orderId    String   @db.VarChar(36)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String   @db.VarChar(36)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}
